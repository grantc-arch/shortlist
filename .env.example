# Copy to .env.local for local use. On Vercel, add these under Project Settings > Environment Variables.

# Random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional in development (`npm run dev`), required in production.
AUTH_SECRET=

# Postgres connection string (Neon or Supabase). Leave empty locally to use the
# built-in PGlite database stored in .data/pglite.
DATABASE_URL=

# --- CV auto-fill (optional) ---
# An Anthropic API key from https://console.anthropic.com. With it set, candidates can
# fill in their profile from their CV. Leave empty to hide the feature.
ANTHROPIC_API_KEY=
# Which Claude model reads CVs. Defaults to claude-haiku-5-5.
# CV_AUTOFILL_MODEL=

# --- Email (optional): password resets, invitations and the daily emails ---
# Any SMTP server. For Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords, and use smtp.gmail.com / 465 / your address / that password.
# Without these, `npm run dev` prints reset links in the terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender, e.g. Shortlist <no-reply@yourdomain.co.za>. Optional when SMTP_USER is an email address.
EMAIL_FROM=

# --- Daily emails (optional) ---
# Job alerts, application updates and new-applicant summaries are sent once a day by Vercel Cron
# (see vercel.json). They only run when this is set: use a long random string, made the same way
# as AUTH_SECRET. Vercel sends it with each call so nobody else can trigger the emails.
CRON_SECRET=

# --- Reported jobs (optional) ---
# Email addresses (comma-separated) of the accounts that review reported jobs at /admin.
# They're also emailed whenever a job is reported.
ADMIN_EMAILS=

# --- Place suggestions (optional) ---
# Defaults to the free public Photon server (OpenStreetMap data).
# PLACES_API_URL=https://photon.komoot.io

# --- Google for Jobs (optional) ---
# Set to true to offer open jobs to Google for Jobs (structured data + sitemap).
# Jobs from demo companies are never listed. Only switch this on once real employers
# are posting, because Google doesn't allow fake or test job postings.
LIST_JOBS_ON_GOOGLE=
# The site's public address, e.g. https://shortlist.co.za. On Vercel this defaults to
# the project's production domain, so you only need it for a custom domain.
SITE_URL=
# The content value of Google Search Console's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
